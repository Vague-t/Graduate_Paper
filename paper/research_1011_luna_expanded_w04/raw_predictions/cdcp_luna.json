      "graphs": [
        {
          "candidate_id": "g0",
          "components": [
            {
              "id": "c1",
              "quote": "When a consumer falls behind on loan or credit card payments, the bank often \"sells\" the account to a debt buying company for a few pennies on the dollar.",
              "occurrence": 0,
              "type": "fact"
            },
            {
              "id": "c2",
              "quote": "Debt buyers contribute nothing to society.",
              "occurrence": 0,
              "type": "value"
            },
            {
              "id": "c3",
              "quote": "Yet, they are allowed to obtain windfall profits by pursuing impoverished consumers for the full face value of such debts.",
              "occurrence": 0,
              "type": "fact"
            },
            {
              "id": "c4",
              "quote": "This is unfair.",
              "occurrence": 0,
              "type": "value"
            },
            {
              "id": "c5",
              "quote": "the bank should be required to notify that consumer, and allow that consumer a fair chance to bid on and purchase his/her own debt, on terms just as favorable as the terms offered to any other debt buyer.",
              "occurrence": 0,
              "type": "policy"
            },
            {
              "id": "c6",
              "quote": "I hope the CFPB will consider new rules in this regard.",
              "occurrence": 0,
