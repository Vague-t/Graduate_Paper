            {
              "id": "c1",
              "quote": "Debt collectors should not be permitted to harass a debtor's ex-spouse by repeatedly calling the ex-spouse.",
              "occurrence": 0,
              "type": "policy"
            },
            {
              "id": "c2",
              "quote": "Debt collectors are known to use the old phone number of the debtor that now belongs to the ex-spouse exclusively.",
              "occurrence": 0,
              "type": "fact"
            },
            {
              "id": "c3",
              "quote": "the ex-spouse tells the collector to remove her phone number from the collector's records",
              "occurrence": 0,
              "type": "testimony"
            },
            {
              "id": "c4",
              "quote": "the collector does not",
              "occurrence": 0,
              "type": "fact"
            },
            {
              "id": "c5",
              "quote": "then repeatedly calls her trying to get to the debtor.",
              "occurrence": 0,
              "type": "fact"
            },
            {
              "id": "c6",
              "quote": "Collectors must be required to remove her phone number from their records at her first request and not be permitted to call her again.",
