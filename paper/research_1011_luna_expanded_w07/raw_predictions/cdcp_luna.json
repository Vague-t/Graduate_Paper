            {
              "id": "c1",
              "quote": "I have experienced a debt collector call me several times in a day although they have already got the voice mail.",
              "occurrence": 0,
              "type": "testimony"
            },
            {
              "id": "c2",
              "quote": "Even if I already have spoke to them and told them my situation and created a \"payment date,\" they call again the next day.",
              "occurrence": 0,
              "type": "testimony"
            },
            {
              "id": "c3",
              "quote": "It is abusive and on hte verge of harrassment.",
              "occurrence": 0,
              "type": "value"
            },
            {
              "id": "c4",
              "quote": "the time that they call is 10pm or 9pm.",
              "occurrence": 0,
              "type": "testimony"
            },
            {
              "id": "c5",
              "quote": "I believe that is too late to call",
              "occurrence": 0,
              "type": "value"
